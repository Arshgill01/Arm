+    const uint32_t   mins_0_3 = sm[1] & kmask1;
+    const uint32_t   mins_4_7 = ((sm[2] >> 4) & kmask2) | (((sm[1] >> 6) & kmask3) << 4);
+    const uint32x2_t mins_u32 = { mins_0_3, mins_4_7 };
+    *out_mins = vreinterpretq_s16_u16(vmovl_u8(vreinterpret_u8_u32(mins_u32)));
+
+    const uint32_t scales_0_3 = sm[0] & kmask1;
+    const uint32_t scales_4_7 = (sm[2] & kmask2) | (((sm[0] >> 6) & kmask3) << 4);
+    const uint32x2_t scales_u32 = { scales_0_3, scales_4_7 };
+    return vreinterpret_s8_u32(scales_u32);
+}
