+    const uint32_t scales_4_7 = (sm[2] & kmask2) | (((sm[0] >> 6) & kmask3) << 4);
+    const uint32x2_t scales_u32 = { scales_0_3, scales_4_7 };
+    return vreinterpret_s8_u32(scales_u32);
+}
