    "candidate": "Use a 4-row by 16-column fixed-width NEON FP32 FMA microkernel when an AArch64 build exposes both SVE and NEON, retaining the existing non-SVE SIMD, RVV and scalar branches.",
    "affected_stages": ["QK GEMM", "V accumulation GEMM"],
    "unaffected_stages": ["K and V conversion/packing", "online softmax", "masking", "tile geometry", "thread partitioning"]
  },
