+                    vaddq_s32(vmulq_s32(vmovl_s16(vget_high_s16(q4sb_scales[0])), acc_lo[1]),
+                              vmulq_s32(vmovl_s16(vget_high_s16(q4sb_scales[1])), acc_hi[1])));
+                acc_f32[1] = vfmaq_f32(acc_f32[1], sb_scale_4567, sumf_4567);
