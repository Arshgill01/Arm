+static inline void decode_q4_K_scales(const block_q4_K & block, block_q4_Kx8_decoded & metadata, int column) {
+    for (int sb = 0; sb < QK_K / 32; sb++) {
+        uint8_t scale;
+        uint8_t min;
+        if (sb < 4) {
+            scale = block.scales[sb] & 63;
+            min   = block.scales[sb + 4] & 63;
+        } else {
+            scale = (block.scales[sb + 4] & 0x0f) | ((block.scales[sb - 4] >> 6) << 4);
+            min   = (block.scales[sb + 4] >> 4) | ((block.scales[sb] >> 6) << 4);
+        }
+        metadata.scales[sb * 8 + column] = scale;
+        metadata.mins[sb * 8 + column]   = min;
+    }
