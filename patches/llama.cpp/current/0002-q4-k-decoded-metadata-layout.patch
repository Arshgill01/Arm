+void ggml_gemv_q4_K_8x4_q8_K_decoded(int                        n,
+                                     float * GGML_RESTRICT      s,
+                                     size_t                     bs,
+                                     const void * GGML_RESTRICT vx,
+                                     const void * GGML_RESTRICT vy,
+                                     int                        nr,
+                                     int                        nc) {
+    constexpr int qk = QK_K;
+    const int     nb = n / qk;
+
+    constexpr int ncols_interleaved = 8;
+
+    assert(n % qk == 0);
+    assert(nc % ncols_interleaved == 0);
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    constexpr int    col_groups = ncols_interleaved / 4;
+    const uint8x16_t m4b        = vdupq_n_u8(0x0f);
+
+    const block_q4_Kx8_decoded_view * GGML_RESTRICT view =
+        (const block_q4_Kx8_decoded_view *) vx;
+    const block_q8_K * GGML_RESTRICT q8_ptr = (const block_q8_K *) vy;
+
+    for (int x = 0; x < nc / ncols_interleaved; x++) {
+        const block_q4_Kx8 * GGML_RESTRICT q4_ptr = view->blocks + x * nb;
+        const block_q4_Kx8_decoded * GGML_RESTRICT metadata = view->metadata + x * nb;
+        float32x4_t acc_f32[col_groups] = { vdupq_n_f32(0), vdupq_n_f32(0) };
+
+        for (int b = 0; b < nb; b++) {
+            const float32x4_t q8_d          = vdupq_n_f32(q8_ptr[b].d);
+            const float32x4_t sb_scale_0123 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) q4_ptr[b].d)), q8_d);
+            const float32x4_t sb_scale_4567 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) q4_ptr[b].d + 4)), q8_d);
+            const float32x4_t sb_min_0123   = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) q4_ptr[b].dmin)), q8_d);
+            const float32x4_t sb_min_4567   = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) q4_ptr[b].dmin + 4)), q8_d);
+
+            int32x4_t bias_acc[2] = { vdupq_n_s32(0), vdupq_n_s32(0) };
+            int32x4_t acc_lo[col_groups];
+            int32x4_t acc_hi[col_groups];
+
+
+            for (int sb = 0; sb < QK_K / 64; sb++) {
+                for (int i = 0; i < col_groups; i++) {
+                    acc_lo[i] = vdupq_n_s32(0);
+                    acc_hi[i] = vdupq_n_s32(0);
+                }
+
+                const int metadata_offset = 2 * sb * 8;
+                const int16x8_t q4sb_scales[2] = {
+                    vreinterpretq_s16_u16(vmovl_u8(vld1_u8(metadata[b].scales + metadata_offset))),
+                    vreinterpretq_s16_u16(vmovl_u8(vld1_u8(metadata[b].scales + metadata_offset + 8))),
+                };
+                const int16x8_t q4sb_mins[2] = {
+                    vreinterpretq_s16_u16(vmovl_u8(vld1_u8(metadata[b].mins + metadata_offset))),
+                    vreinterpretq_s16_u16(vmovl_u8(vld1_u8(metadata[b].mins + metadata_offset + 8))),
