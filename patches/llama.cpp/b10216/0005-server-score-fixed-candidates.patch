+def test_score_candidates_matches_exact_next_token_logprobs():
+    global server
+    server.n_slots = 4
+    server.start()
+
+    prompt = "I believe the meaning of life is"
+    baseline = server.make_request("POST", "/completion", data={
+        "prompt": prompt,
+        "n_probs": 4,
+        "temperature": 0.0,
+        "n_predict": 1,
+        "cache_prompt": False,
+    })
+    assert baseline.status_code == 200
+    top = baseline.body["completion_probabilities"][0]["top_logprobs"]
+    candidates = [[item["id"]] for item in top]
+
+    scored = server.make_request("POST", "/score", data={
+        "prompt": prompt,
+        "candidates": candidates,
+        "cache_prompt": False,
+    })
+    assert scored.status_code == 200
+    assert scored.body["object"] == "candidate_scores"
+    assert scored.body["score_semantics"] == "raw_pre_sampling_logprob"
+    assert scored.body["shared_prompt"] is True
+    assert scored.body["selected_index"] == 0
+    assert len(scored.body["candidates"]) == len(candidates)
+    for actual, expected in zip(scored.body["candidates"], top):
+        assert actual["tokens"] == [expected["id"]]
+        assert actual["sum_logprob"] == pytest.approx(expected["logprob"], abs=1e-6)
+        assert actual["token_logprobs"][0]["logprob"] == pytest.approx(expected["logprob"], abs=1e-6)
+
+
+def test_score_candidates_forces_complete_continuations():
+    global server
+    server.n_slots = 2
+    server.start()
+
+    candidates = [[1205, 278], [478, 259]]
+    scored = server.make_request("POST", "/score", data={
+        "prompt": "The answer is",
+        "candidates": candidates,
+        "cache_prompt": False,
+    })
+    assert scored.status_code == 200
+    tokenized = server.make_request("POST", "/tokenize", data={
+        "content": "The answer is",
+        "add_special": True,
+    })
+    assert tokenized.status_code == 200
+    for actual, expected in zip(scored.body["candidates"], candidates):
+        assert actual["tokens"] == expected
+        assert [item["id"] for item in actual["token_logprobs"]] == expected
+        assert len(actual["token_logprobs"]) == len(expected)
+        assert actual["sum_logprob"] == pytest.approx(
+            sum(item["logprob"] for item in actual["token_logprobs"]), abs=1e-12)
+
+        serial_score = 0.0
+        prefix = list(tokenized.body["tokens"])
+        for token in expected:
+            step = server.make_request("POST", "/completion", data={
+                "prompt": prefix,
+                "n_predict": 1,
+                "n_probs": 0,
+                "probability_ids": [token],
+                "temperature": 0.0,
+                "cache_prompt": False,
+            })
+            assert step.status_code == 200
+            selected = step.body["completion_probabilities"][0]["selected_logprobs"]
+            assert selected[0]["id"] == token
+            serial_score += selected[0]["logprob"]
+            prefix.append(token)
+        assert actual["sum_logprob"] == pytest.approx(serial_score, abs=2e-6)
+
+
+def test_score_candidates_rejects_more_candidates_than_slots():
