+    this->post_score = [this](const server_http_req & req) {
+        auto res = create_response();
+        auto & rd = res->rd;
+
+        res->set_req(&req);
+
+        const int64_t t_start = ggml_time_us();
+        std::vector<llama_tokens> candidates;
+
+        try {
+            const json data = json::parse(req.body);
+
+            if (!data.contains("prompt")) {
+                throw std::invalid_argument("\"prompt\" is required");
+            }
+            if (!data.contains("candidates") || !data.at("candidates").is_array()) {
+                throw std::invalid_argument("\"candidates\" must be an array");
+            }
+
+            const auto & candidates_json = data.at("candidates");
+            if (candidates_json.size() < 2) {
+                throw std::invalid_argument("\"candidates\" must contain at least two continuations");
+            }
+            if (candidates_json.size() > (size_t) params.n_parallel) {
+                throw std::invalid_argument(string_format(
+                    "\"candidates\" has %zu entries but the server has only %d parallel slots",
+                    candidates_json.size(), params.n_parallel));
+            }
+
+            auto prompts = tokenize_input_prompts(ctx_server.vocab, ctx_server.mctx, data.at("prompt"), true, true);
+            if (prompts.size() != 1) {
+                throw std::invalid_argument("\"prompt\" must contain exactly one prompt");
+            }
+            if (prompts[0].has_media()) {
+                throw std::invalid_argument("multimodal prompts are not supported by /score");
+            }
+
+            constexpr size_t MAX_CANDIDATE_TOKENS = 128;
+            constexpr size_t MAX_TOTAL_CANDIDATE_TOKENS = 512;
+            size_t n_candidate_tokens = 0;
+
+            candidates.reserve(candidates_json.size());
+            for (const auto & candidate : candidates_json) {
+                llama_tokens tokens;
+                if (candidate.is_string()) {
+                    tokens = common_tokenize(ctx_server.vocab, candidate.get<std::string>(), false, true);
+                } else if (json_is_array_of_numbers(candidate)) {
+                    tokens = candidate.get<llama_tokens>();
+                } else {
+                    throw std::invalid_argument("each candidate must be a string or an array of token ids");
+                }
+
+                if (tokens.empty()) {
+                    throw std::invalid_argument("candidate continuations must not be empty");
+                }
+                if (tokens.size() > MAX_CANDIDATE_TOKENS) {
+                    throw std::invalid_argument(string_format(
+                        "candidate continuations must not exceed %zu tokens", MAX_CANDIDATE_TOKENS));
+                }
+                if (prompts[0].size() + tokens.size() + 1 >= (size_t) meta->slot_n_ctx) {
+                    throw std::invalid_argument("prompt and candidate exceed the slot context size");
+                }
+                for (llama_token token : tokens) {
+                    if (token < 0 || token >= meta->model_vocab_n_tokens) {
+                        throw std::invalid_argument("candidate contains an invalid token id");
+                    }
+                    if (llama_vocab_is_eog(ctx_server.vocab, token)) {
+                        throw std::invalid_argument("candidate continuations must not contain end-of-generation tokens");
+                    }
+                }
+
+                n_candidate_tokens += tokens.size();
+                candidates.push_back(std::move(tokens));
+            }
+            if (n_candidate_tokens > MAX_TOTAL_CANDIDATE_TOKENS) {
+                throw std::invalid_argument(string_format(
+                    "candidate continuations must not exceed %zu tokens in total", MAX_TOTAL_CANDIDATE_TOKENS));
+            }
+
+            json task_data = {
+                {"cache_prompt", json_value(data, "cache_prompt", true)},
+                {"n_cmpl", candidates.size()},
+                {"n_predict", candidates[0].size()},
+                {"return_tokens", true},
+                {"stream", false},
+            };
+
+            server_task task(SERVER_TASK_TYPE_COMPLETION);
+            task.id     = rd.get_new_id();
+            task.tokens = std::move(prompts[0]);
+            task.params = server_schema::eval_llama_cmpl_schema(
+                ctx_server.vocab,
+                params,
+                meta->slot_n_ctx,
+                meta->logit_bias_eog,
+                task_data);
+            task.params.antiprompt.clear();
+            task.params.oaicompat_model = meta->model_name;
+            task.score_tokens = candidates[0];
+
+            for (size_t i = 1; i < candidates.size(); ++i) {
+                task.add_child(task.id, rd.get_new_id());
+                auto & child = task.child_tasks.back();
+                child.params.n_predict = candidates[i].size();
+                child.score_tokens = candidates[i];
+            }
+
+            std::vector<server_task> tasks;
+            tasks.push_back(std::move(task));
+            rd.post_tasks(std::move(tasks));
+        } catch (const std::exception & e) {
+            res->error(format_error_response(e.what(), ERROR_TYPE_INVALID_REQUEST));
+            return res;
+        }
+
+        auto all_results = rd.wait_for_all(req.should_stop);
+        if (all_results.is_terminated) {
+            return res;
+        }
+        if (all_results.error) {
+            res->error(all_results.error->to_json());
+            return res;
+        }
+
+        json scores = json::array();
+        size_t selected_index = 0;
+        double selected_score = -std::numeric_limits<double>::infinity();
+        int32_t prompt_tokens = 0;
+        int32_t prompt_tokens_cached = 0;
+
+        for (size_t i = 0; i < all_results.results.size(); ++i) {
+            auto * cmpl = dynamic_cast<server_task_result_cmpl_final *>(all_results.results[i].get());
+            GGML_ASSERT(cmpl != nullptr);
+
+            if (cmpl->score_logprobs.size() != candidates[i].size()) {
+                res->error(format_error_response("candidate scoring stopped before all tokens were evaluated", ERROR_TYPE_SERVER));
+                return res;
+            }
+
+            json token_logprobs = json::array();
+            double score = 0.0;
+            for (size_t j = 0; j < candidates[i].size(); ++j) {
+                score += cmpl->score_logprobs[j];
+                token_logprobs.push_back({
+                    {"id", candidates[i][j]},
+                    {"logprob", cmpl->score_logprobs[j]},
+                });
+            }
+
+            scores.push_back({
+                {"index", i},
+                {"content", cmpl->content},
+                {"tokens", candidates[i]},
+                {"token_logprobs", std::move(token_logprobs)},
+                {"sum_logprob", score},
+                {"mean_logprob", score / candidates[i].size()},
+                {"timings", cmpl->timings.to_json()},
+            });
+
+            if (score > selected_score) {
+                selected_index = i;
+                selected_score = score;
+            }
+
+            prompt_tokens = cmpl->n_prompt_tokens;
+            prompt_tokens_cached = std::max(prompt_tokens_cached, cmpl->n_prompt_tokens_cache);
+        }
+
+        res->ok({
+            {"object", "candidate_scores"},
+            {"model", meta->model_name},
+            {"score_semantics", "raw_pre_sampling_logprob"},
+            {"shared_prompt", true},
+            {"prompt_tokens", prompt_tokens},
+            {"prompt_tokens_cached", prompt_tokens_cached},
+            {"candidates", std::move(scores)},
+            {"selected_index", selected_index},
+            {"request_ms", (ggml_time_us() - t_start) / 1000.0},
+        });
+        return res;
+    };
