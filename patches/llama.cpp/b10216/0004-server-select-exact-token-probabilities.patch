+def test_probability_ids_match_top_logprobs():
+    global server
+    server.start()
+    request = {
+        "prompt": "I believe the meaning of life is",
+        "n_probs": 10,
+        "temperature": 0.0,
+        "n_predict": 1,
+        "cache_prompt": False,
+    }
+    baseline = server.make_request("POST", "/completion", data=request)
+    assert baseline.status_code == 200
+    top = baseline.body["completion_probabilities"][0]["top_logprobs"]
+    selected_ids = [top[0]["id"], top[3]["id"]]
+
+    selected = server.make_request("POST", "/completion", data={
+        **request,
+        "n_probs": 0,
+        "probability_ids": selected_ids,
+    })
+    assert selected.status_code == 200
+    output = selected.body["completion_probabilities"][0]
+    assert "top_logprobs" not in output
+    assert [item["id"] for item in output["selected_logprobs"]] == selected_ids
+    expected = {item["id"]: item["logprob"] for item in top}
+    for item in output["selected_logprobs"]:
+        assert item["logprob"] == pytest.approx(expected[item["id"]], abs=1e-6)
+
+
 def test_n_probs_stream():
     global server
     server.start()
