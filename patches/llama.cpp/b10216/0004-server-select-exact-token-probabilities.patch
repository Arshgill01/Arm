diff --git a/tools/server/server-schema.cpp b/tools/server/server-schema.cpp
index 674d3ba33..225db99b1 100644
--- a/tools/server/server-schema.cpp
+++ b/tools/server/server-schema.cpp
@@ -180,6 +180,30 @@ std::vector<std::unique_ptr<field>> make_llama_cmpl_schema(const common_params &
         ->add_alias("logprobs") // use "logprobs" if "n_probs" wasn't provided
         ->set_desc("If greater than 0, output the probabilities of top N tokens for each generated token"));

+    add((new field_json("probability_ids"))
+        ->set_desc("Return pre-sampling probabilities for up to 256 exact token ids")
+        ->set_handler([&](field_eval_context & ctx, const json & data) {
+            const auto & values = data.at("probability_ids");
+            if (!values.is_array() || values.size() > 256) {
+                throw std::invalid_argument("must be an array of at most 256 token ids");
+            }
+
+            std::unordered_set<llama_token> seen;
+            for (const auto & value : values) {
+                if (!value.is_number_integer()) {
+                    throw std::invalid_argument("entries must be integer token ids");
+                }
+                const auto token = value.get<llama_token>();
+                if (token < 0 || token >= llama_vocab_n_tokens(ctx.vocab)) {
+                    throw std::invalid_argument("token id is outside the model vocabulary");
+                }
+                if (!seen.insert(token).second) {
+                    throw std::invalid_argument("token ids must be unique");
+                }
+                ctx.params.probability_ids.push_back(token);
+            }
+        }));
+
     add((new field_num("min_keep", params.sampling.min_keep))
         ->set_hard_limits(0, INT32_MAX)
         ->set_desc("If greater than 0, force samplers to return at least N possible tokens"));
