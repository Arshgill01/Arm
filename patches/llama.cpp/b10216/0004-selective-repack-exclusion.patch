+static bool ggml_repack_tensor_is_excluded(const struct ggml_tensor * cur) {
+    static const std::vector<std::regex> patterns = [] {
+        std::vector<std::regex> result;
+        const char * value = std::getenv("GGML_CPU_REPACK_EXCLUDE");
+        if (value == nullptr || value[0] == '\0') {
+            return result;
+        }
+
+        const std::string input(value);
+        size_t begin = 0;
+        while (begin <= input.size()) {
+            const size_t end = input.find(';', begin);
+            const std::string pattern = input.substr(begin, end - begin);
+            if (pattern.empty()) {
+                GGML_ABORT("GGML_CPU_REPACK_EXCLUDE contains an empty regular expression");
+            }
+            try {
+                result.emplace_back(pattern);
+            } catch (const std::regex_error & error) {
+                GGML_ABORT("invalid GGML_CPU_REPACK_EXCLUDE regular expression '%s': %s", pattern.c_str(), error.what());
+            }
+            if (end == std::string::npos) {
+                break;
+            }
+            begin = end + 1;
+        }
+        return result;
+    }();
+
+    for (const auto & pattern : patterns) {
+        if (std::regex_search(cur->name, pattern)) {
+            GGML_LOG_INFO("%s: excluded tensor %s\n", __func__, cur->name);
+            return true;
+        }
+    }
+    return false;
+}
+
 static const ggml::cpu::tensor_traits * ggml_repack_get_optimal_repack_type(const struct ggml_tensor * cur) {
+    if (ggml_repack_tensor_is_excluded(cur)) {
+        return nullptr;
+    }
