+static void ggml_backend_cpu_repack_dump_tensor(
+        ggml_backend_buffer_t buffer,
+        const struct ggml_tensor * tensor,
+        const ggml::cpu::repack::tensor_traits_base * tensor_traits,
+        size_t size) {
+    const char * directory = std::getenv("GGML_CPU_REPACK_DUMP_DIR");
+    if (directory == nullptr || directory[0] == '\0') {
+        return;
+    }
+
+    std::string safe_name(tensor->name);
+    for (char & character : safe_name) {
+        const unsigned char value = static_cast<unsigned char>(character);
+        if (!std::isalnum(value) && character != '.' && character != '_' && character != '-') {
+            character = '_';
+        }
+    }
+    if (safe_name.empty() || safe_name == "." || safe_name == "..") {
+        GGML_ABORT("cannot dump repacked tensor with unsafe name '%s'", tensor->name);
+    }
+
+    static std::mutex dump_mutex;
+    static bool inventory_initialized = false;
+    std::lock_guard<std::mutex> lock(dump_mutex);
+    const std::string prefix(directory);
+    const auto base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(buffer));
+    const auto data = reinterpret_cast<uintptr_t>(tensor->data);
+    const std::string tensor_path = prefix + "/" + safe_name + ".bin";
+    std::ofstream tensor_output(tensor_path, std::ios::binary | std::ios::trunc);
+    if (!tensor_output.write(static_cast<const char *>(tensor->data), size)) {
+        GGML_ABORT("failed to dump repacked tensor '%s' to '%s'", tensor->name, tensor_path.c_str());
+    }
+    tensor_output.close();
+    if (!tensor_output) {
+        GGML_ABORT("failed to close repacked tensor dump '%s'", tensor_path.c_str());
+    }
+
+    const std::string inventory_path = prefix + "/inventory.tsv";
+    std::ofstream inventory_output(
+        inventory_path,
+        std::ios::out | (inventory_initialized ? std::ios::app : std::ios::trunc));
+    if (!inventory_initialized) {
+        const std::string runtime_path = prefix + "/runtime.tsv";
+        std::ofstream runtime_output(runtime_path, std::ios::out | std::ios::trunc);
+        runtime_output
+            << "buffer_base\tbuffer_size_bytes\n0x" << std::hex << base << std::dec << '\t'
+            << ggml_backend_buffer_get_size(buffer) << '\n';
+        if (!runtime_output) {
+            GGML_ABORT("failed to write repack runtime identity '%s'", runtime_path.c_str());
+        }
+        inventory_output << "tensor\tfile\ttype\tparameter_type\tne0\tne1\tne2\tne3\tbytes\tbuffer_offset\tcolumns\tinterleave\n";
+        inventory_initialized = true;
+    }
+    inventory_output
+        << tensor->name << '\t'
+        << safe_name << ".bin\t"
+        << ggml_type_name(tensor->type) << '\t'
+        << ggml_type_name(tensor_traits->parameter_type()) << '\t'
+        << tensor->ne[0] << '\t' << tensor->ne[1] << '\t'
+        << tensor->ne[2] << '\t' << tensor->ne[3] << '\t'
+        << size << '\t' << data - base << '\t'
+        << tensor_traits->column_group_size() << '\t'
+        << tensor_traits->interleave_size() << '\n';
+    if (!inventory_output) {
+        GGML_ABORT("failed to append repacked tensor inventory '%s'", inventory_path.c_str());
+    }
+}
