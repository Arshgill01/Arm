+                        activation_scratch + ir * tile_rows + row_start,
+                        gate_scratch + ir * tile_rows + row_start,
+                        up_scratch + ir * tile_rows + row_start);
+            }
+
+            ggml_barrier(params->threadpool);
+
+            const size_t tile_stride = ggml_row_size(PARAM_TYPE, tile_rows);
+            for (int64_t ir = ith * 4; ir < n_tokens - n_tokens % 4; ir += nth * 4) {
+                ggml_quantize_mat_t<INTER_SIZE, PARAM_TYPE>(
+                        activation_scratch + ir * tile_rows,
+                        tile_data + ir * tile_stride, 4, tile_rows);
+            }
+            for (int64_t ir = rows_processed + ith; ir < n_tokens; ir += nth) {
+                from_float(activation_scratch + ir * tile_rows, tile_data + ir * tile_stride, tile_rows);
+            }
+
+            ggml_barrier(params->threadpool);
+
+            int64_t down_start = (ith * n_embd) / nth;
+            int64_t down_end   = ((ith + 1) * n_embd) / nth;
+            down_start = (down_start + NB_COLS - 1) / NB_COLS * NB_COLS;
+            down_end   = (down_end + NB_COLS - 1) / NB_COLS * NB_COLS;
+            down_end   = MIN(down_end, n_embd);
+            float * down_scratch = activation_scratch + tile_rows * n_tokens;
+            const size_t input_block_offset = (tile_start / QK_K) * down_block_bytes;
+            for (int64_t down_row = down_start; down_row < down_end; down_row += NB_COLS) {
+                const char * down_weights = (const char *) down->src[0]->data +
+                        down_row * down->src[0]->nb[1] + input_block_offset;
+                if (gemm_rows > 0) {
+                    if (down->src[0]->type == GGML_TYPE_Q6_K) {
+                        gemm<block_q6_K, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                                tile_rows, down_scratch + down_row, n_embd,
+                                down_weights, tile_data, gemm_rows, NB_COLS);
+                    } else {
+                        gemm<block_q4_K, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                                tile_rows, down_scratch + down_row, n_embd,
+                                down_weights, tile_data, gemm_rows, NB_COLS);
+                    }
+                }
+                for (int64_t ir = gemm_rows; ir < n_tokens; ++ir) {
+                    if (down->src[0]->type == GGML_TYPE_Q6_K) {
+                        gemv<block_q6_K, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                                tile_rows, down_scratch + ir * n_embd + down_row, NB_COLS,
+                                down_weights, tile_data + ir * tile_stride, 1, NB_COLS);
+                    } else {
+                        gemv<block_q4_K, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                                tile_rows, down_scratch + ir * n_embd + down_row, NB_COLS,
+                                down_weights, tile_data + ir * tile_stride, 1, NB_COLS);
+                    }
+                }
+            }
+            const int64_t down_rows = down_end - down_start;
+            for (int64_t ir = 0; ir < n_tokens; ++ir) {
+                float * dst = (float *) ((char *) down->data + ir * down->nb[1]) + down_start;
+                float * src = down_scratch + ir * n_embd + down_start;
+                if (tile_start == 0) {
+                    memcpy(dst, src, down_rows * sizeof(float));
+                } else {
+                    for (int64_t i = 0; i < down_rows; ++i) {
+                        dst[i] += src[i];
+                    }
+                }
+            }
+
+            ggml_barrier(params->threadpool);
+        }
+
+        return true;
+    }
+
+    int64_t repack_interleave() const override { return INTER_SIZE; }
+    int64_t repack_columns() const override { return NB_COLS; }
