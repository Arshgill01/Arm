+    bool compute_forward_tiled_ffn(
+            struct ggml_compute_params * params,
+            struct ggml_tensor * gate,
+            struct ggml_tensor * up,
+            struct ggml_tensor * activation,
+            struct ggml_tensor * down,
+            ggml::cpu::tensor_traits * down_traits) override {
+        if (gate->op != GGML_OP_MUL_MAT ||
+            up->op != GGML_OP_MUL_MAT ||
+            activation->op != GGML_OP_GLU ||
+            down->op != GGML_OP_MUL_MAT ||
+            gate->src[1] != up->src[1] ||
+            gate->src[0]->type != GGML_TYPE_Q4_K ||
+            up->src[0]->type != GGML_TYPE_Q4_K ||
+            (down->src[0]->type != GGML_TYPE_Q4_K && down->src[0]->type != GGML_TYPE_Q6_K) ||
+            gate->src[1]->type != GGML_TYPE_F32 ||
+            gate->type != GGML_TYPE_F32 ||
+            up->type != GGML_TYPE_F32 ||
+            activation->type != GGML_TYPE_F32 ||
+            down->type != GGML_TYPE_F32 ||
+            !ggml_are_same_shape(gate, up) ||
+            !ggml_are_same_shape(gate, activation) ||
+            ggml_n_dims(gate->src[0]) != 2 ||
+            ggml_n_dims(up->src[0]) != 2 ||
+            ggml_n_dims(down->src[0]) != 2 ||
+            gate->ne[2] != 1 || gate->ne[3] != 1 ||
+            gate->src[1]->ne[2] != 1 || gate->src[1]->ne[3] != 1 ||
+            gate->nb[0] != sizeof(float) ||
+            up->nb[0] != sizeof(float) ||
+            activation->nb[0] != sizeof(float) ||
+            down->nb[0] != sizeof(float) ||
+            PARAM_TYPE != GGML_TYPE_Q8_K ||
+            down_traits->repack_interleave() != INTER_SIZE ||
+            down_traits->repack_columns() != NB_COLS) {
+            return false;
+        }
+
+        const int64_t n_embd   = gate->src[0]->ne[0];
+        const int64_t n_ff     = gate->src[0]->ne[1];
+        const int64_t n_tokens = gate->src[1]->ne[1];
+        const int     ith      = params->ith;
+        const int     nth      = params->nth;
+        int64_t       tile     = n_ff - n_embd < 1024 ? n_ff - n_embd : 1024;
+        tile -= tile % QK_K;
+        if (tile < QK_K || n_ff % QK_K != 0 ||
+            down->src[0]->ne[0] != n_ff || down->src[0]->ne[1] != n_embd ||
+            down->ne[0] != n_embd || down->ne[1] != n_tokens) {
+            return false;
+        }
+
+        char *       wdata          = static_cast<char *>(params->wdata);
+        const size_t input_stride    = ggml_row_size(PARAM_TYPE, n_embd);
+        const size_t tile_stride_max = ggml_row_size(PARAM_TYPE, tile);
+        char *       tile_data       = wdata + input_stride * n_tokens;
+        if (params->wsize < (input_stride + tile_stride_max) * n_tokens) {
+            return false;
+        }
+
+        const ggml_from_float_t from_float = ggml_get_type_traits_cpu(PARAM_TYPE)->from_float;
+        for (int64_t ir = ith * 4; ir < n_tokens - n_tokens % 4; ir += nth * 4) {
+            ggml_quantize_mat_t<INTER_SIZE, PARAM_TYPE>(
+                    (float *) ((char *) gate->src[1]->data + ir * gate->src[1]->nb[1]),
+                    wdata + ir * input_stride, 4, n_embd);
+        }
+        const int64_t rows_processed = n_tokens - n_tokens % 4;
+        for (int64_t ir = rows_processed + ith; ir < n_tokens; ir += nth) {
+            from_float(
+                    (float *) ((char *) gate->src[1]->data + ir * gate->src[1]->nb[1]),
+                    wdata + ir * input_stride, n_embd);
+        }
+
+        ggml_barrier(params->threadpool);
+
+        float * gate_scratch      = (float *) gate->data;
+        float * up_scratch        = (float *) up->data;
+        float * activation_scratch = (float *) activation->data;
+        const size_t down_block_bytes = ggml_row_size(down->src[0]->type, QK_K) * NB_COLS;
+        for (int64_t tile_start = 0; tile_start < n_ff; tile_start += tile) {
+            const int64_t tile_rows = MIN(tile, n_ff - tile_start);
+            int64_t row_start = (ith * tile_rows) / nth;
+            int64_t row_end   = ((ith + 1) * tile_rows) / nth;
+            row_start = (row_start + NB_COLS - 1) / NB_COLS * NB_COLS;
+            row_end   = (row_end + NB_COLS - 1) / NB_COLS * NB_COLS;
+            row_end   = MIN(row_end, tile_rows);
+            const int64_t rows = row_end - row_start;
+            const int64_t gemm_rows = n_tokens - n_tokens % 4;
+            const char * gate_weights = (const char *) gate->src[0]->data + (tile_start + row_start) * gate->src[0]->nb[1];
+            const char * up_weights   = (const char *) up->src[0]->data + (tile_start + row_start) * up->src[0]->nb[1];
+
+            if (rows > 0 && gemm_rows > 0) {
+                gemm<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, gate_scratch + row_start, tile_rows, gate_weights, wdata, gemm_rows, rows);
+                gemm<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, up_scratch + row_start, tile_rows, up_weights, wdata, gemm_rows, rows);
+            }
+            for (int64_t ir = gemm_rows; rows > 0 && ir < n_tokens; ++ir) {
+                gemv<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, gate_scratch + ir * tile_rows + row_start, rows, gate_weights,
+                        wdata + ir * input_stride, 1, rows);
+                gemv<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, up_scratch + ir * tile_rows + row_start, rows, up_weights,
+                        wdata + ir * input_stride, 1, rows);
+            }
+            for (int64_t ir = 0; ir < n_tokens; ++ir) {
