+    bool compute_forward_tiled_ffn(
+            struct ggml_compute_params * params,
+            struct ggml_tensor * gate,
+            struct ggml_tensor * up,
+            struct ggml_tensor * activation) override {
+        if (gate->op != GGML_OP_MUL_MAT ||
+            up->op != GGML_OP_MUL_MAT ||
+            activation->op != GGML_OP_GLU ||
+            gate->src[1] != up->src[1] ||
+            gate->src[0]->type != GGML_TYPE_Q4_K ||
+            up->src[0]->type != GGML_TYPE_Q4_K ||
+            gate->src[1]->type != GGML_TYPE_F32 ||
+            gate->type != GGML_TYPE_F32 ||
+            up->type != GGML_TYPE_F32 ||
+            activation->type != GGML_TYPE_F32 ||
+            !ggml_are_same_shape(gate, up) ||
+            !ggml_are_same_shape(gate, activation) ||
+            ggml_n_dims(gate->src[0]) != 2 ||
+            ggml_n_dims(up->src[0]) != 2 ||
+            gate->ne[2] != 1 || gate->ne[3] != 1 ||
+            gate->src[1]->ne[2] != 1 || gate->src[1]->ne[3] != 1 ||
+            gate->nb[0] != sizeof(float) ||
+            up->nb[0] != sizeof(float) ||
+            activation->nb[0] != sizeof(float)) {
+            return false;
+        }
+
+        const int64_t n_embd   = gate->src[0]->ne[0];
+        const int64_t n_ff     = gate->src[0]->ne[1];
+        const int64_t n_tokens = gate->src[1]->ne[1];
+        const int     ith      = params->ith;
+        const int     nth      = params->nth;
+        int64_t       tile     = n_ff / nth < 64 ? n_ff / nth : 64;
+        tile -= tile % NB_COLS;
+        if (tile < NB_COLS || n_ff % NB_COLS != 0 || nth * tile > n_ff) {
+            return false;
+        }
+
+        char *       wdata      = static_cast<char *>(params->wdata);
+        const size_t src1_stride = ggml_row_size(PARAM_TYPE, n_embd);
+        if (params->wsize < src1_stride * n_tokens) {
+            return false;
+        }
+
+        const ggml_from_float_t from_float = ggml_get_type_traits_cpu(PARAM_TYPE)->from_float;
+        for (int64_t ir = ith * 4; ir < n_tokens - n_tokens % 4; ir += nth * 4) {
+            ggml_quantize_mat_t<INTER_SIZE, PARAM_TYPE>(
+                    (float *) ((char *) gate->src[1]->data + ir * gate->src[1]->nb[1]),
+                    wdata + ir * src1_stride, 4, n_embd);
+        }
+        const int64_t rows_processed = n_tokens - n_tokens % 4;
+        for (int64_t ir = rows_processed + ith; ir < n_tokens; ir += nth) {
+            from_float(
+                    (float *) ((char *) gate->src[1]->data + ir * gate->src[1]->nb[1]),
+                    wdata + ir * src1_stride, n_embd);
+        }
+
+        ggml_barrier(params->threadpool);
+
+        float * gate_scratch = (float *) gate->data + ith * tile * n_tokens;
+        float * up_scratch   = (float *) up->data + ith * tile * n_tokens;
+        for (int64_t row = ith * tile; row < n_ff; row += nth * tile) {
+            const int64_t rows = MIN(tile, n_ff - row);
+            const char * gate_weights = (const char *) gate->src[0]->data + row * gate->src[0]->nb[1];
+            const char * up_weights   = (const char *) up->src[0]->data + row * up->src[0]->nb[1];
+            const int64_t gemm_rows   = n_tokens - n_tokens % 4;
+
+            if (gemm_rows > 0) {
+                gemm<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, gate_scratch, tile, gate_weights, wdata, gemm_rows, rows);
+                gemm<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, up_scratch, tile, up_weights, wdata, gemm_rows, rows);
+            }
+            for (int64_t ir = gemm_rows; ir < n_tokens; ++ir) {
+                gemv<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, gate_scratch + ir * tile, rows, gate_weights,
+                        wdata + ir * src1_stride, 1, rows);
+                gemv<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                        n_embd, up_scratch + ir * tile, rows, up_weights,
+                        wdata + ir * src1_stride, 1, rows);
+            }
+            for (int64_t ir = 0; ir < n_tokens; ++ir) {
+                ggml_vec_swiglu_f32(
+                        rows,
+                        (float *) ((char *) activation->data + ir * activation->nb[1]) + row,
+                        gate_scratch + ir * tile,
+                        up_scratch + ir * tile);
+            }
+        }
+
+        return true;
+    }
