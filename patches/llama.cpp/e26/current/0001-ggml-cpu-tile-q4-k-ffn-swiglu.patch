+static bool ggml_cpu_tiled_ffn_roles_match(
+        const struct ggml_tensor * gate,
+        const struct ggml_tensor * up) {
+    static const char gate_suffix[] = ".ffn_gate.weight";
+    static const char up_suffix[]   = ".ffn_up.weight";
+    const size_t gate_name_length   = strlen(gate->src[0]->name);
+    const size_t up_name_length     = strlen(up->src[0]->name);
+    const size_t gate_suffix_length = sizeof(gate_suffix) - 1;
+    const size_t up_suffix_length   = sizeof(up_suffix) - 1;
+    if (gate_name_length <= gate_suffix_length || up_name_length <= up_suffix_length) {
+        return false;
+    }
+    const size_t gate_prefix_length = gate_name_length - gate_suffix_length;
+    const size_t up_prefix_length   = up_name_length - up_suffix_length;
+    return gate_prefix_length == up_prefix_length &&
+           memcmp(gate->src[0]->name, up->src[0]->name, gate_prefix_length) == 0 &&
+           strcmp(gate->src[0]->name + gate_prefix_length, gate_suffix) == 0 &&
+           strcmp(up->src[0]->name + up_prefix_length, up_suffix) == 0;
+}
 
