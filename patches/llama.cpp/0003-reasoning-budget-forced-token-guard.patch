diff --git a/common/reasoning-budget.cpp b/common/reasoning-budget.cpp
index 1fe242d..f988aea 100644
--- a/common/reasoning-budget.cpp
+++ b/common/reasoning-budget.cpp
@@ -133,6 +133,16 @@ static void common_reasoning_budget_accept(struct llama_sampler * smpl, llama_to
         }
         case REASONING_BUDGET_FORCING:
         {
+            if (ctx->force_pos >= ctx->forced_tokens.size() ||
+                token != ctx->forced_tokens[ctx->force_pos]) {
+                COM_TRC("ignoring unexpected token %d while forcing token %d\n",
+                        token,
+                        ctx->force_pos < ctx->forced_tokens.size()
+                            ? ctx->forced_tokens[ctx->force_pos]
+                            : -1);
+                break;
+            }
+
             // track the end sequence within forced_tokens so it is also reported on DONE
             const int32_t match = ctx->end_matcher.advance(token);
             ctx->force_pos++;
